# Local development. Leave GEMINI_API_KEY empty and set GOOGLE_CLOUD_PROJECT to use Vertex AI with
# `gcloud auth application-default login`; leave both empty to run without AI (fallbacks only).
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
KEDAI_MODEL=gemini-3.5-flash-lite
KEDAI_STORE=memory            # memory | firestore
KEDAI_ADMIN_TOKEN=
# Phoenix tracing (optional)
PHOENIX_COLLECTOR_ENDPOINT=   # e.g. http://localhost:6006/v1/traces
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=jaga-kedai
KEDAI_TRACE_CONTENT=false
